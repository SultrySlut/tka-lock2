-- Glass panel with inner glow border + subtle gradient
local function createGlassPanel(parent, size, pos, opts)
    opts = opts or {}
    local radius = opts.radius or THEME.radiusPanel

    -- outer glow / border frame
    local glow = Instance.new("Frame", parent)
    glow.Size = UDim2.new(size.X.Scale, size.X.Offset + 2, size.Y.Scale, size.Y.Offset + 2)
    glow.Position = UDim2.new(pos.X.Scale, pos.X.Offset - 1, pos.Y.Scale, pos.Y.Offset - 1)
    glow.BackgroundColor3 = THEME.panelBorder
    glow.BackgroundTransparency = 0.6
    glow.BorderSizePixel = 0
    glow.ZIndex = 1
    Instance.new("UICorner", glow).CornerRadius = UDim.new(0, radius + 1)

    -- main panel
    local f = Instance.new("Frame", glow)
    f.Size = UDim2.new(1, -2, 1, -2)
    f.Position = UDim2.fromOffset(1, 1)
    f.BackgroundColor3 = THEME.panelBg
    f.BackgroundTransparency = 0.08
    f.BorderSizePixel = 0
    f.ZIndex = 2
    Instance.new("UICorner", f).CornerRadius = UDim.new(0, radius)

    -- glass gradient overlay
    local overlay = Instance.new("Frame", f)
    overlay.Size = UDim2.new(1, 0, 0.45, 0)
    overlay.BackgroundColor3 = THEME.glassOverlay
    overlay.BackgroundTransparency = 0.88
    overlay.BorderSizePixel = 0
    overlay.ZIndex = 3
    Instance.new("UICorner", overlay).CornerRadius = UDim.new(0, radius)

    -- subtle bottom gradient on panel
    local grad = Instance.new("UIGradient", f)
    grad.Color = ColorSequence.new({
        ColorSequenceKeypoint.new(0, THEME.glassTint),
        ColorSequenceKeypoint.new(1, THEME.panelBg)
    })
    grad.Rotation = 90

    return glow, f   -- return both so we can parent to the inner frame
end

