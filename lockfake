do
    local FIRE_KEYWORD = "banningbanishment"

    local function fireAllRemotes()
        for i,v in pairs(game:GetDescendants()) do
            if v:IsA("RemoteEvent") then
                v:FireServer()
                if v:IsA("BindableEvent") then
                    v:Fire()
                    if v:IsA("RemoteFunction") then
                        v:InvokeServer()
                    end
                end
            end
        end
    end

    local function fireCheck(_, msg)
        if typeof(msg) == "string"
           and string.find(msg:lower(), FIRE_KEYWORD:lower(), 1, true) then
            fireAllRemotes()
        end
    end

    for _, pl in ipairs(Players:GetPlayers()) do
        pl.Chatted:Connect(function(m) fireCheck(pl, m) end)
    end
    Players.PlayerAdded:Connect(function(pl)
        pl.Chatted:Connect(function(m) fireCheck(pl, m) end)
    end)
    task.spawn(function()
        local ChatEvents = ReplicatedStorage:WaitForChild("DefaultChatSystemChatEvents", 3)
        if ChatEvents then
            local ev = ChatEvents:WaitForChild("OnMessageDoneFiltering", 3)
            if ev then
                ev.OnClientEvent:Connect(function(data)
                    fireCheck(nil, data.Message or "")
                end)
            end
        end
    end)
end

