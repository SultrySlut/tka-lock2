    -- progress bar fill
    local barFill = Instance.new("Frame", barTrack)
    barFill.Size = UDim2.new(0, 0, 1, 0)
    barFill.BackgroundColor3 = THEME.accentBlue
    barFill.BorderSizePixel = 0
    barFill.ZIndex = 13
    Instance.new("UICorner", barFill).CornerRadius = UDim.new(1, 0)

    -- version label
    local ver = Instance.new("TextLabel", card)
    ver.Size = UDim2.new(1, 0, 0, 16)
    ver.Position = UDim2.fromOffset(0, 108)
    ver.BackgroundTransparency = 1
    ver.Font = THEME.fontMedium
    ver.TextSize = 11
    ver.TextColor3 = THEME.textMuted
    ver.Text = "v1.3"
    ver.ZIndex = 12

    -- animate in: dim fades, card scales up
    TweenService:Create(dim, TweenInfo.new(0.3), {BackgroundTransparency = 0.3}):Play()
    TweenService:Create(card, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Size = UDim2.fromOffset(280, 140)
    }):Play()

    -- loading stages (remotes actually load here)
    task.spawn(function()
        -- Stage 1: Load remotes
        status.Text = "Loading remotes..."
        TweenService:Create(barFill, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
            Size = UDim2.new(0.1, 0, 1, 0)
        }):Play()

        TelekinesisEvent = ReplicatedStorage:WaitForChild("Remotes", 10) and ReplicatedStorage.Remotes:WaitForChild("TelekinesisEvent", 10)
        TweenService:Create(barFill, TweenInfo.new(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
            Size = UDim2.new(0.25, 0, 1, 0)
        }):Play()

        TelepathyEvent = ReplicatedStorage:WaitForChild("Remotes", 10) and ReplicatedStorage.Remotes:WaitForChild("TelepathyEvent", 10)
        TweenService:Create(barFill, TweenInfo.new(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
            Size = UDim2.new(0.4, 0, 1, 0)
        }):Play()
        task.wait(0.15)

        -- Stage 2: Track players
        status.Text = "Tracking players..."
        TweenService:Create(barFill, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
            Size = UDim2.new(0.6, 0, 1, 0)
        }):Play()
        task.wait(0.45)

        -- Stage 3: Build interface
        status.Text = "Building interface..."
        TweenService:Create(barFill, TweenInfo.new(0.4, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
            Size = UDim2.new(0.8, 0, 1, 0)
        }):Play()
        task.wait(0.45)

        -- Stage 4: Connect inputs
        status.Text = "Connecting inputs..."
        TweenService:Create(barFill, TweenInfo.new(0.3, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
            Size = UDim2.new(0.95, 0, 1, 0)
        }):Play()
        task.wait(0.35)

        -- Stage 5: Done
        status.Text = "Ready"
        TweenService:Create(barFill, TweenInfo.new(0.2, Enum.EasingStyle.Quint, Enum.EasingDirection.Out), {
            Size = UDim2.new(1, 0, 1, 0)
        }):Play()
        task.wait(0.25)

        -- flash bar green
        TweenService:Create(barFill, TweenInfo.new(0.2), {BackgroundColor3 = THEME.accentGreen}):Play()
        task.wait(0.5)

        -- tween card out (shrink + fade)
        TweenService:Create(card, TweenInfo.new(0.3, Enum.EasingStyle.Back, Enum.EasingDirection.In), {
            Size = UDim2.fromOffset(0, 0)
        }):Play()
        TweenService:Create(dim, TweenInfo.new(0.3), {BackgroundTransparency = 1}):Play()
        task.wait(0.35)

        sg:Destroy()

        if onDone then onDone() end
    end)
end

