    lbl.TextSize = 13
    lbl.TextXAlignment = Enum.TextXAlignment.Left
    lbl.TextColor3 = THEME.textPrimary
    lbl.Text = text
    lbl.ZIndex = 5

    local val = Instance.new("TextLabel", frame)
    val.Size = UDim2.fromOffset(44, 18)
    val.Position = UDim2.new(1, -50, 0, 0)
    val.BackgroundTransparency = 1
    val.Font = THEME.fontSemibold
    val.TextSize = 13
    val.TextColor3 = THEME.accentBlue
    val.TextXAlignment = Enum.TextXAlignment.Right
    val.ZIndex = 5

    -- track
    local bar = Instance.new("Frame", frame)
    bar.Size = UDim2.new(1, -16, 0, 6)
    bar.Position = UDim2.fromOffset(8, 24)
    bar.BackgroundColor3 = THEME.sliderTrack
    bar.BorderSizePixel = 0
    bar.ZIndex = 5
    Instance.new("UICorner", bar).CornerRadius = UDim.new(1, 0)

    -- fill
    local fill = Instance.new("Frame", bar)
    fill.BackgroundColor3 = THEME.sliderFill
    fill.BorderSizePixel = 0
    fill.ZIndex = 6
    Instance.new("UICorner", fill).CornerRadius = UDim.new(1, 0)

    -- knob
    local knob = Instance.new("Frame", bar)
    knob.Size = UDim2.fromOffset(14, 14)
    knob.AnchorPoint = Vector2.new(0.5, 0.5)
    knob.BackgroundColor3 = THEME.knob
    knob.BorderSizePixel = 0
    knob.ZIndex = 7
    Instance.new("UICorner", knob).CornerRadius = UDim.new(1, 0)
    local kStroke = Instance.new("UIStroke", knob)
    kStroke.Color = THEME.accentBlue
    kStroke.Thickness = 2
    kStroke.Transparency = 0.3

    local dragging = false
    local function setValue(v, anim)
        v = math.clamp(v, minv, maxv)
        local rel = (v - minv) / (maxv - minv)
        val.Text = tostring(v)
        fill.Size = UDim2.new(rel, 0, 1, 0)
        local p = UDim2.new(rel, 0, 0.5, 0)
        if anim then
            TweenService:Create(knob, TweenInfo.new(0.08), {Position = p}):Play()
        else
            knob.Position = p
        end
        callback(v)
    end
    setValue(initial, false)

    bar.InputBegan:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then
            dragging = true
            setValue(math.round(minv + ((inp.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X) * (maxv - minv)), true)
        end
    end)
    bar.InputEnded:Connect(function(inp)
        if inp.UserInputType == Enum.UserInputType.MouseButton1 then dragging = false end
    end)
    UserInputService.InputChanged:Connect(function(inp)
        if dragging and inp.UserInputType == Enum.UserInputType.MouseMovement then
            setValue(math.round(minv + ((inp.Position.X - bar.AbsolutePosition.X) / bar.AbsoluteSize.X) * (maxv - minv)), false)
        end
    end)
end

