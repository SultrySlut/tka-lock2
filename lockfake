local function makeESP(plr)
    if State.ESP[plr] then return end
    local t = Drawing.new("Text")
    t.Font, t.Size, t.Center = 3, 18, true
    t.Outline, t.OutlineColor = true, Color3.new(0, 0, 0)
    t.Visible = Config.ShowESP
    State.ESP[plr] = t
end

local function removeESP(plr)
    local d = State.ESP[plr]
    if d then d:Remove(); State.ESP[plr] = nil end
end

local function studsDistance(a, b)
    if not (a.Character and b.Character) then return math.huge end
    local h1 = a.Character:FindFirstChild("HumanoidRootPart")
    local h2 = b.Character:FindFirstChild("HumanoidRootPart")
    if not (h1 and h2) then return math.huge end
    return (h1.Position - h2.Position).Magnitude
end

local function colourByDist(d)
    -- Resolve current thresholds. In dynamic mode, the boundaries scale
    -- with the trigger bot's effective range so the close-band always
    -- represents "in push range right now", regardless of velocity/ping.
    local close, medium, far
    if Config.DynamicRange then
        -- Use a static estimate of safe range here (no per-target velocity
        -- because this colours all players, not just the closest one).
        -- It's the base trigger range adjusted for ping only.
        local lat = (1 / math.max(Config.TRIGGER_REPLICATION_HZ, 1)) + getPingSeconds() * 0.5
        local effectiveBase = math.max(Config.TRIGGER_RANGE - lat * 50, Config.TRIGGER_RANGE_FLOOR)
        close  = effectiveBase
        medium = effectiveBase * 2
        far    = effectiveBase * 4
    else
        close, medium, far = Config.DIST_CLOSE, Config.DIST_MEDIUM, Config.DIST_FAR
    end
    if d <= close  then return Color3.fromRGB(255, 60, 120) end
    if d <= medium then return Color3.fromRGB(180, 80, 255) end
    if d <= far    then return Color3.fromRGB(90, 140, 255) end
    return Color3.fromRGB(140, 150, 170)
end

local function buildESPText(plr, hp, dist)
    local parts = {}
    if Config.ShowName  then table.insert(parts, plr.DisplayName) end
    if Config.ShowHP    then table.insert(parts, "[" .. hp .. " HP]") end
    if Config.ShowStuds then
        local s = tostring(dist)
        -- Closing-speed arrow: down = distance dropping (approaching us),
        -- up = fleeing. Omitted when motion is near-zero to avoid noise.
        if Config.ShowClosing then
            local v = State.Closing[plr]
            if v then
                if     v < -2 then s = s .. " \xE2\x86\x93"   -- ↓ closing
                elseif v >  2 then s = s .. " \xE2\x86\x91"   -- ↑ fleeing
                end
            end
        end
        table.insert(parts, "[" .. s .. "]")
    end
    if State.Whitelist[plr] == false then table.insert(parts, "[IGNORED]") end
    return table.concat(parts, " ")
end

local function updateESP()
    local now = tick()
    for plr, txt in pairs(State.ESP) do
        local char = plr.Character
        local head = char and char:FindFirstChild("Head")
        if char and head then
            local vp, onScr = Camera:WorldToViewportPoint(head.Position)
            txt.Visible = Config.ShowESP and onScr
            if onScr then
                txt.Position = Vector2.new(vp.X, vp.Y - 25)
                local dist = studsDistance(LocalPlayer, plr)

                -- EMA on raw closing speed, sampled at most ~20Hz to keep it stable
                local lastD, lastT = State.LastDist[plr], State.LastDistTime[plr]
                if lastD and lastT then
                    local dt = now - lastT
                    if dt > 0.05 then
                        local raw  = (dist - lastD) / dt           -- negative = approaching
                        local prev = State.Closing[plr] or 0
                        State.Closing[plr]      = prev * 0.7 + raw * 0.3
                        State.LastDist[plr]     = dist
                        State.LastDistTime[plr] = now
                    end
                else
                    State.LastDist[plr]     = dist
                    State.LastDistTime[plr] = now
                end

                local hp = "?"
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hum then hp = math.floor(hum.Health) end
                txt.Text  = buildESPText(plr, hp, math.floor(dist))
                txt.Color = colourByDist(dist)
            end
        else
            txt.Visible = false
        end
    end
end

