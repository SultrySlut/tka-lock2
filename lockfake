----------------------------------------------------------------
--  INIT
----------------------------------------------------------------
local function init()
    buildGUI()
    trackPlayers()
    UserInputService.InputBegan:Connect(onInputBegan)
    UserInputService.InputEnded:Connect(onInputEnded)
    local lastUpdate = { esp = 0, hover = 0, ff = 0, arrows = 0, radar = 0 }
    RunService.RenderStepped:Connect(function()
        -- Cursor follows every frame (feels bad if it doesn't).
        FOV.Position = UserInputService:GetMouseLocation()

        local now      = tick()
        local interval = 1 / math.max(Config.UPDATE_RATE or 30, 1)
        local espInt   = 1 / math.max(Config.ESP_UPDATE_RATE or 60, 1)

        -- ESP at its own (higher) rate so head-tracking text stays smooth.
        if now - lastUpdate.esp >= espInt then
            lastUpdate.esp = now
            pcall(updateESP)
        end

        -- Non-ESP systems: slower cadence, half the CPU/GPU load.
        if now - lastUpdate.ff >= interval then
            lastUpdate.ff = now
            pcall(updateForceFields)
        end
        if now - lastUpdate.arrows >= interval then
            lastUpdate.arrows = now
            pcall(updateArrows)
        end
        if now - lastUpdate.radar >= interval then
            lastUpdate.radar = now
            pcall(updateRadar)
        end

        -- Hover highlight: gated at ESP_UPDATE_RATE too. nearestToCursor does
        -- a raycast per in-FOV whitelisted player, so running it 240x/sec on
        -- a high-refresh monitor is a lot of wasted work.
        if Config.ShowHighlight and not State.TelepathyTogOn
           and now - lastUpdate.hover >= espInt then
            lastUpdate.hover = now
            local p, _ = nearestToCursor()
            if p ~= State.HoverPlayer then
                State.HoverPlayer = p
                local hl = State.HoverHighlight
                if not hl or not hl.Parent then
                    hl = Instance.new("Highlight")
                    hl.Name             = "HoverHL"
                    hl.FillColor        = Color3.fromRGB(255, 60, 150)
                    hl.OutlineColor     = Color3.new(1, 1, 1)
                    hl.FillTransparency = 0.85
                    hl.Parent           = CoreGui
                    State.HoverHighlight = hl
                end
                if p and p.Character then
                    hl.Adornee = p.Character
                    hl.Enabled = true
                else
                    hl.Enabled = false
                    hl.Adornee = nil
                end
            end
        end
    end)
end

