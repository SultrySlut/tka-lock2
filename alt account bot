local function canAttackNow(myPos, targetPos)
    -- Prevent overlapping attacks
    if not myPos or not targetPos then return false, "NO_POSITION" end

    -- Stamina check for grab ability
    local stamina = getStamina()
    if stamina and stamina < CONFIG.GRAB_STAMINA_COST then
        return false, "LOW_STAMINA"
    end
    
    local target = getCurrentTarget()
    if not target then return false, "NO_TARGET" end
    if not isPlayerAlive(target) then return false, "TARGET_DEAD" end
    if updateInvisibilityState(target) then return false, "TARGET_INVISIBLE" end
    
    -- Can't grab underwater target from above surface
    -- Use terrain water check for alt (water parts can have extended bounds causing false positives)
    local altHead = getHead(player)
    local altInTerrainWater = altHead and terrainWaterAtPoint(altHead.Position)
    if isPlayerSubmerged(target) and not altInTerrainWater then
        return false, "TARGET_SUBMERGED"
    end
    
    -- Can't attack targets in no-chase zones (house/towers) - applies to ALL targets
    if isInNoChaseZone(targetPos) then
        return false, "NO_CHASE_ZONE"
    end
    
    -- Can't attack targets outside map bounds
    if isOutsideMapBounds(targetPos) then
        return false, "OUTSIDE_MAP"
    end
    
    -- Can't attack through border barrier
    if isBorderBetween(myPos, targetPos) then
        return false, "BORDER_BARRIER"
    end

    -- Distance check (use velocity-scaled combat zone)
    local distance = (myPos - targetPos).Magnitude
    if distance > S.effectiveCombatZone then
        return false, "OUT_OF_RANGE"
    end
    
    -- Shield permission
    local canGrab, shieldReason = canGrabTarget(myPos, targetPos)
    if not canGrab then return false, shieldReason end
    
    -- Cooldown check
    local now = tick()
    if now - S.lastQClickTime < CONFIG.Q_CLICK_COOLDOWN then
        return false, "COOLDOWN"
    end
    
    return true, "CLEAR"
end

local function executeAttack(myPos, targetPos, distance)
    if S.isAttacking then return false end
    S.isAttacking = true
    
    -- Keep moving TOWARD target during attack to close gap while grab connects
    clearKey(Enum.KeyCode.S)
    clearKey(Enum.KeyCode.A)
    clearKey(Enum.KeyCode.D)
    pulseKey(Enum.KeyCode.W, CONFIG.PULSE_W)
    
    local canAttack, reason = canAttackNow(myPos, targetPos)
    if not canAttack then 
        S.isAttacking = false
        return false 
    end
    
    local target = getCurrentTarget()
    if not target then 
        S.isAttacking = false
        return false 
    end
    
    -- Range check - must be within 75 studs (exact max grab range)
    if distance > 75 then
        S.isAttacking = false
        return false
    end
    
    -- 1. Q key fires remote automatically via pressKey callback
    pulseKey(Enum.KeyCode.Q, CONFIG.PULSE_Q)
    
    -- 2. Wait for grab confirmation (FollowMouse)
    local grabConnected = false
    local startTime = tick()
    local maxWait = 0.8
    
    while tick() - startTime < maxWait do
        -- Each Q pulse fires remote automatically via pressKey
        pulseKey(Enum.KeyCode.Q, CONFIG.PULSE_Q)
        
        local myRoot = getRoot(player)
        local hasFollowMouse = myRoot and myRoot:FindFirstChild("FollowMouse")
        
        if hasFollowMouse then
            grabConnected = true
            break
        end
        
        task.wait(0.03)
    end
    
    if not grabConnected then
        clearKey(Enum.KeyCode.Q)
        S.lastQClickTime = tick()  -- Set cooldown even on miss to prevent spam
        S.isAttacking = false
        return false
    end
    
    -- 3. Grab connected - get current distance for push/pull decision
    local currentMyPos = getMyPosition()
    local currentTargetPos = getPlayerPosition(target)
    local currentDistance = distance
    if currentMyPos and currentTargetPos then
        currentDistance = (currentTargetPos - currentMyPos).Magnitude
    end
    
    -- 4. Click to throw (push/pull based on distance)
    local vp = Camera.ViewportSize
    local cx, cy = vp.X / 2, vp.Y / 2
    
    if currentDistance < CONFIG.OPTIMAL_DISTANCE then
        sendClickAt(cx, cy - CONFIG.CLICK_ABOVE_OFFSET)
        S.throwPhase = "PUSH"
    else
        sendClickAt(cx, cy + CONFIG.CLICK_BELOW_OFFSET)
        S.throwPhase = "PULL"
    end

    S.lastQClickTime = tick()

    -- 5. Brief hold after click, then release
    task.wait(0.05)
    clearKey(Enum.KeyCode.Q)
    
    S.isAttacking = false
    return true
end

