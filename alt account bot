-- Backup InputBegan hook for Q presses (main combat uses fireTelekinesisRemote directly)
local function fireTelekinesis(hold, part)
    local cf = Camera.CFrame
    local tgt = part or workspace.Terrain
    TelekinesisEvent:FireServer("Q", hold, cf, tgt, cf)
end

-- Listen for virtual AND real Q presses
UserInputService.InputBegan:Connect(function(input, processed)
    -- Skip during active attack (executeAttack handles remote directly)
    if S.isAttacking then return end
    
    -- Remove the processed check so virtual input works
    if input.KeyCode == Enum.KeyCode.Q and S.following then
        local target = getCurrentTarget()
        if target then
            local char = getChar(target)
            if char then
                local part = char:FindFirstChild("Head") or char:FindFirstChild("HumanoidRootPart")
                if part then
                    fireTelekinesis(true, part)
                end
            end
        end
    end
end)

UserInputService.InputEnded:Connect(function(input, processed)
    if input.KeyCode == Enum.KeyCode.Q and S.following then
        fireTelekinesis(false, nil)  -- nil on release like lock script
    end
end)

