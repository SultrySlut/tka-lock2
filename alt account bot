local function recordAttacker(attackerPlayer, damage)
    if not attackerPlayer then return end
    if attackerPlayer == player then return end
    if damage ~= CONFIG.SELF_DEFENSE_DAMAGE then return end
    
    local userId = attackerPlayer.UserId
    local now = tick()
    
    if not S.selfDefense.attackers[userId] then
        S.selfDefense.attackers[userId] = {
            hits = 0,
            lastHitTime = 0,
        }
    end
    
    local data = S.selfDefense.attackers[userId]
    
    -- Reset hits if too old
    if now - data.lastHitTime > CONFIG.SELF_DEFENSE_HIT_WINDOW then
        data.hits = 0
    end
    
    data.hits = data.hits + 1
    data.lastHitTime = now
    
    print("Self-defense: " .. attackerPlayer.Name .. " hit us (" .. data.hits .. " hits)")
    
    -- Check if we should switch to this attacker
    if data.hits >= CONFIG.SELF_DEFENSE_HIT_THRESHOLD then
        local shouldSwitch = false
        local reason = ""
        
        -- Check if idle (not following or target dead)
        local isIdling = not S.following or S.targetWasDead or not S.targetPlayer
        
        if isIdling then
            shouldSwitch = true
            reason = "IDLE"
        else
            -- Check if main target is out of range
            local myPos = getMyPosition()
            local mainTargetPos = S.targetPlayer and getPlayerPosition(S.targetPlayer)
            if myPos and mainTargetPos then
                local distToMain = (myPos - mainTargetPos).Magnitude
                if distToMain > CONFIG.COMBAT_ZONE then
                    shouldSwitch = true
                    reason = "MAIN_OUT_OF_RANGE"
                end
            else
                shouldSwitch = true
                reason = "NO_MAIN_POS"
            end
        end
        
        if shouldSwitch then
            S.selfDefense.tempTargetUserId = userId
            S.selfDefense.tempTargetReason = "SELF_DEFENSE"
            print("Self-defense: Switching to " .. attackerPlayer.Name .. " (" .. reason .. ")")
        end
    end
end

clearTempTarget = function()
    if S.selfDefense.tempTargetUserId then
        local targetPlayer = getPlayerByUserId(S.selfDefense.tempTargetUserId)
        print("Clearing temp target: " .. (targetPlayer and targetPlayer.Name or "unknown") .. " (reason: " .. (S.selfDefense.tempTargetReason or "none") .. ")")
    end
    S.selfDefense.tempTargetUserId = nil
    S.selfDefense.tempTargetReason = nil
end

getTempTarget = function()
    if not S.selfDefense.tempTargetUserId then return nil end
    
    local target = getPlayerByUserId(S.selfDefense.tempTargetUserId)
    if not target or not isPlayerAlive(target) then
        -- Target died - clear temp target
        print("Temp target died - clearing")
        clearTempTarget()
        return nil
    end
    
    return target
end

local function shouldClearTempTarget()
    if not S.selfDefense.tempTargetUserId then return false end
    
    -- Clear if main target comes back in range
    if S.targetPlayer and isPlayerAlive(S.targetPlayer) then
        local myPos = getMyPosition()
        local mainTargetPos = getPlayerPosition(S.targetPlayer)
        if myPos and mainTargetPos then
            local distToMain = (myPos - mainTargetPos).Magnitude
            if distToMain <= CONFIG.COMBAT_ZONE then
                print("Main target back in range - clearing temp target")
                return true
            end
        end
    end
    
    return false
end

updateTempTargetLogic = function()
    -- Check if we should clear temp target
    if shouldClearTempTarget() then
        clearTempTarget()
        return
    end
    
    -- If not following, don't do help-alt logic
    if not S.following then return end
    
    -- If already have a temp target, don't override
    if S.selfDefense.tempTargetUserId then return end
    
    -- If main target is alive and in range, don't help alts
    if S.targetPlayer and isPlayerAlive(S.targetPlayer) then
        local myPos = getMyPosition()
        local mainTargetPos = getPlayerPosition(S.targetPlayer)
        if myPos and mainTargetPos then
            local distToMain = (myPos - mainTargetPos).Magnitude
            if distToMain <= CONFIG.COMBAT_ZONE then
                return -- Main target available, no need to help
            end
        end
    end
    
    -- Check if we should help another alt (from alt file system)
    local myPos = getMyPosition()
    if not myPos then return end
    
    local otherTargets = getOtherAltsTargets()
    for _, info in ipairs(otherTargets) do
        -- Skip if targeting self
        if info.targetUserId == player.UserId then
            continue
        end
        -- Skip if it's our own target
        if S.targetPlayer and info.targetUserId == S.targetPlayer.UserId then
            continue
        end
        
        local targetPlayer = getPlayerByUserId(info.targetUserId)
        if targetPlayer and isPlayerAlive(targetPlayer) then
            local targetPos = getPlayerPosition(targetPlayer)
            if targetPos then
                local dist = (myPos - targetPos).Magnitude
                if dist <= CONFIG.HELP_ALT_RANGE then
                    S.selfDefense.tempTargetUserId = info.targetUserId
                    S.selfDefense.tempTargetReason = "HELP_ALT"
                    print("Helping alt " .. info.altName .. " - attacking " .. info.targetName)
                    return
                end
            end
        end
    end
end

local function bindDamageDetection(char)
    local hum = char:WaitForChild("Humanoid", 10)
    if not hum then return end
    
    local lastHealth = hum.Health
    local lastDamagerPlayer = nil
    local lastDamagerTime = 0
    
    local function considerDamagerTag(child)
        if not child:IsA("ObjectValue") then return end
        if child.Name:sub(1, 7) ~= "Damaged" then return end
        local v = child.Value
        if typeof(v) == "Instance" and v:IsA("Player") then
            lastDamagerPlayer = v
            lastDamagerTime = os.clock()
        end
    end
    
    for _, c in ipairs(hum:GetChildren()) do
        considerDamagerTag(c)
    end
    hum.ChildAdded:Connect(considerDamagerTag)
    
    hum.HealthChanged:Connect(function(newHealth)
        if newHealth < lastHealth then
            local dmg = lastHealth - newHealth
            
            -- Track any hit for unstick prevention
            S.lastHitTime = tick()
            
            -- If we're currently unsticking, snap out of it
            if S.isUnsticking then
                S.isUnsticking = false
                S.unstickDirection = nil
                S.unstickEndTime = 0
                print("Unstick cancelled - got hit!")
            end
            
            task.defer(function()
                local now = os.clock()
                if lastDamagerPlayer and (now - lastDamagerTime) <= 1.5 then
                    recordAttacker(lastDamagerPlayer, dmg)
                end
            end)
        end
        lastHealth = newHealth
    end)
end

