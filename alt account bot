    frame.Size = UDim2.new(0, 400, 0, 350)
    frame.Position = UDim2.new(0, 10, 0, 10)
    frame.BackgroundColor3 = Color3.new(0, 0, 0)
    frame.BackgroundTransparency = 0.3
    frame.BorderSizePixel = 2
    frame.BorderColor3 = Color3.new(0, 1, 1)
    frame.Parent = gui
    
    local text = Instance.new("TextLabel")
    text.Name = "DebugText"
    text.Size = UDim2.new(1, -10, 1, -10)
    text.Position = UDim2.new(0, 5, 0, 5)
    text.BackgroundTransparency = 1
    text.TextColor3 = Color3.new(0, 1, 1)
    text.TextSize = 14
    text.Font = Enum.Font.RobotoMono
    text.TextXAlignment = Enum.TextXAlignment.Left
    text.TextYAlignment = Enum.TextYAlignment.Top
    text.Text = "Initializing..."
    text.Parent = frame
    
    gui.Parent = playerGui
    S.debugGui = gui
end

local function updateDebugGui(info)
    if not S.debugGui then return end
    local textLabel = S.debugGui:FindFirstChild("Frame") and S.debugGui.Frame:FindFirstChild("DebugText")
    if textLabel then
        textLabel.Text = info
    end
end

-- =====================================================
-- MAIN MOVEMENT LOOP (Section 22 State Machine)
-- =====================================================

local function processMovementFrame(dt)
    if not S.following or S.altIsDead then return end
    if S.tauntPauseActive then return end
    
    local myPos = getMyPosition()
    local target = getCurrentTarget()
    local targetPos = target and getPlayerPosition(target)  -- Change #4: Use getPlayerPosition
    
    if not myPos then return end
    
    -- Update key states
    updateKeyStates()
    
    -- Update water state
    updateWaterState()
    
    -- Update air management
    updateAirManagement(dt)
    
    -- Update boundary state
    updateBoundaryState(myPos)
    
    -- Update river method
    if targetPos then
        updateRiverMethodState(targetPos, tick())
    end
    
    -- Update target availability (throttled to reduce raycast spam)
    local now = tick()
    if now - S.lastStructureCheck >= CONFIG.STRUCTURE_CHECK_RATE then
        S.lastStructureCheck = now
        updateStructureTrapped()
    end
    
    -- Update secondary target logic
    updateSecondaryTargetLogic(myPos)
    
    -- Auto-secondary from other alts
    updateAutoSecondary(myPos)
    
    -- Update temp target logic (self-defense / help-alt)
    updateTempTargetLogic()
    
    -- Refresh current target
    target = getCurrentTarget()
    targetPos = target and getPlayerPosition(target)  -- Change #4: Use getPlayerPosition
    
    -- Cache last known position
    if targetPos then
        S.lastKnownPosition = targetPos
    end
    
    -- Calculate distance
    local distance = targetPos and (myPos - targetPos).Magnitude or 0
    local hDist = targetPos and math.sqrt((targetPos.X - myPos.X)^2 + (targetPos.Z - myPos.Z)^2) or 0
    
    -- EARLY velocity tracking and effectiveCombatZone (needed before ANY attack checks)
    if targetPos and S.targetLastPos then
        local frameVelocity = (targetPos - S.targetLastPos) / math.max(dt, 0.001)
        local toTarget = (targetPos - myPos).Unit
        
        -- Update exponential moving average of velocity (frame-rate independent)
        local effectiveAlpha = math.min(1, S.PREDICT_VELOCITY_ALPHA * dt * 60)
        S.targetVelocityAvg = S.targetVelocityAvg:Lerp(frameVelocity, effectiveAlpha)
        
        local fleeingDot = S.targetVelocityAvg.Magnitude > 1 and S.targetVelocityAvg.Unit:Dot(toTarget) or 0
        
        -- Fleeing if target moving away (dot > 0.3) with some speed
        if fleeingDot > 0.3 and S.targetVelocityAvg.Magnitude > 10 then
            S.targetFleeingTimer = S.targetFleeingTimer + dt
        else
            S.targetFleeingTimer = 0
        end
        
        S.targetIsFleeing = S.targetFleeingTimer > S.FLEE_TIME_THRESHOLD
    elseif not targetPos then
        S.targetVelocityAvg = Vector3.new(0, 0, 0)
        S.targetFleeingTimer = 0
        S.targetIsFleeing = false
    end
    
    -- Calculate effective combat zone (used by canAttackNow and state machine)
    S.effectiveCombatZone = CONFIG.COMBAT_ZONE
    if S.targetIsFleeing then
        local targetSpeed = S.targetVelocityAvg.Magnitude
        local velocityReduction = math.max(0, (targetSpeed - 20) * 0.175)
        S.effectiveCombatZone = math.max(50, S.FLEE_COMBAT_ENTRY - velocityReduction)
    end
    
    -- Check target death
    local targetAlive = target and isPlayerAlive(target)
    if not targetAlive and not S.targetWasDead then
        S.targetWasDead = true
        S.hasSentTaunt = false
        scheduleTaunt(distance)
    elseif targetAlive and S.targetWasDead then
        S.targetWasDead = false
        S.hasSentTaunt = false
    end
    
    -- Manage flight stamina
    manageFlightStamina()
    
    -- ==========================================
    -- STATE MACHINE (Section 22)
    -- ==========================================
    
    -- RESURFACE MODE (exclusive state)
    if S.resurfaceMode then
        S.currentState = "RESURFACE"
        performSafeResurface()
        
        local stamina = getStamina() or 0
        local canFly = stamina > getEffectiveStaminaMin()
        local resurType = canFly and "DOLPHIN DIVE" or "SWIM UP"
        
        -- Calculate height above start for dolphin
        local heightInfo = ""
        if canFly and S.dolphinStartY then
            local heightAbove = myPos.Y - S.dolphinStartY
            heightInfo = string.format("\nPhase: %s\nHeight: %.1f / %.0f studs", 
                S.dolphinPhase, heightAbove, CONFIG.DOLPHIN_MAX_HEIGHT)
        end
        
        -- Calculate time spent resurfacing
        local resurTime = S.resurfaceStartTime > 0 and (tick() - S.resurfaceStartTime) or 0
        
        local debugInfo = string.format([[
STATE: RESURFACE
Mode: %s%s
Air: %.1f / %.1f
Head in water: %s
Stamina: %.0f
Resurface time: %.1fs
]], 
            resurType,
            heightInfo,
            S.airRemaining, CONFIG.UNDERWATER_MAX_TIME,
            tostring(S.headInWater),
            stamina,
            resurTime
        )
        updateDebugGui(debugInfo)
        return
    end
    
    -- BOUNDARY HANDLING
    if S.outsideBoundary then
        S.currentState = "RETURNING_TO_MAP"
        disableFlight()
        local returnDir = getBoundaryReturnDirection(myPos)
        safeSetCamera(myPos, myPos + returnDir * 50)
        pulseKey(Enum.KeyCode.W, CONFIG.PULSE_W)
        
        updateDebugGui("STATE: RETURNING_TO_MAP\nWalking back to safe zone...")
        return
    end
    
    if S.nearBoundary then
        S.currentState = "BOUNDARY_WALK"
        disableFlight()
    
        -- Always walk toward center - ignore target until safe
        local returnDir = getBoundaryReturnDirection(myPos)
        safeSetCamera(myPos, myPos + returnDir * 50)
        pulseKey(Enum.KeyCode.W, CONFIG.PULSE_W)
    
        updateDebugGui("STATE: BOUNDARY_WALK\nNear map edge - returning to safe zone...")
        return
end
    
    -- NO TARGET or TARGET DEAD
    if not target or S.targetWasDead then
        S.currentState = "IDLE"
        
        -- ALWAYS disable flight when idle - regardless of taunt state
        disableFlight()
        
        if S.targetWasDead and not S.hasSentTaunt then
            -- Waiting for taunt - stay still
            stopAllMovementKeys()
            updateDebugGui("STATE: IDLE (waiting for taunt)")
        else
            -- Light wandering - always pulse for smooth movement
            
            -- Occasionally pick new direction
            if not S.idleFacingDirection or math.random() > 0.98 then
                local angle = math.random() * math.pi * 2
                S.idleFacingDirection = Vector3.new(math.cos(angle), 0, math.sin(angle))
            end
            
            safeSetCamera(myPos, myPos + S.idleFacingDirection * 20)
            
            -- Always pulse for continuous smooth walking
            pulseKey(Enum.KeyCode.W, CONFIG.PULSE_IDLE_WALK)
            
            updateDebugGui("STATE: IDLE (wandering)")
        end
        return
    end
    
    -- TARGET UNAVAILABLE (Section 12)
    -- Only apply to primary target - secondary/temp targets have their own availability checks
    local isOnAlternateTarget = S.onSecondaryTarget or S.selfDefense.tempTargetUserId
    if not S.targetAvailable and not isOnAlternateTarget then
        S.currentState = "UNAVAILABLE_BAND"
        
        -- Guard against nil targetPos
        if not targetPos then
            -- No target position - just idle in place
            disableFlight()
            stopAllMovementKeys()
            updateDebugGui("STATE: UNAVAILABLE_BAND\nNo target position - idling...")
            return
        end
        
        -- Calculate distance from target
        local distFromTarget = (myPos - targetPos).Magnitude
        
        -- Phase 1: Fly outward to retreat distance (if flight available)
        if distFromTarget < CONFIG.UNAVAILABLE_RETREAT_DIST then
            -- Not at retreat distance yet - fly outward
            local stamina = getStamina()
            local canFly = stamina and stamina > getEffectiveStaminaMin()
            
            if canFly and not S.flightDisabledForStamina then
                -- Fly outward (away from target)
                ensureFlight()
                
                local awayDir = safeUnit(myPos - targetPos)
                -- Keep horizontal, slight up to avoid terrain
                awayDir = safeUnit(Vector3.new(awayDir.X, 0.1, awayDir.Z))
                safeSetCamera(myPos, myPos + awayDir * 50)
                pulseKey(Enum.KeyCode.W, CONFIG.PULSE_W)
                
                local debugInfo = string.format([[
STATE: UNAVAILABLE_BAND (RETREATING)
Reason: %s
Target: %s
Distance: %.1f / %.1f
Flying outward to retreat distance...
]], 
                    S.unavailableReason or "Unknown",
                    (target and target.Name or "Unknown"),
                    distFromTarget,
                    CONFIG.UNAVAILABLE_RETREAT_DIST
                )
                updateDebugGui(debugInfo)
                return
            else
                -- No stamina for flight - walk outward
                local awayDir = safeUnit(Vector3.new((myPos - targetPos).X, 0, (myPos - targetPos).Z))
                safeSetCamera(myPos, myPos + awayDir * 50)
                pulseKey(Enum.KeyCode.W, CONFIG.PULSE_W)
                
                local debugInfo = string.format([[
STATE: UNAVAILABLE_BAND (WALKING AWAY)
Reason: %s
Target: %s
Distance: %.1f / %.1f
Walking outward (no stamina for flight)...
]], 
                    S.unavailableReason or "Unknown",
                    (target and target.Name or "Unknown"),
                    distFromTarget,
                    CONFIG.UNAVAILABLE_RETREAT_DIST
                )
                updateDebugGui(debugInfo)
                return
            end
        end
        
        -- Phase 2: At retreat distance - disable flight and idle on ground
        disableFlight()
        
        -- Light idle wandering (ground only) - always pulse for smooth movement
        -- Occasionally pick new direction
        if not S.idleFacingDirection or math.random() > 0.98 then
            local angle = math.random() * math.pi * 2
            S.idleFacingDirection = Vector3.new(math.cos(angle), 0, math.sin(angle))
        end
        
        safeSetCamera(myPos, myPos + S.idleFacingDirection * 20)
        
        -- Always pulse for continuous smooth walking
        pulseKey(Enum.KeyCode.W, CONFIG.PULSE_IDLE_WALK)
        
        local debugInfo = string.format([[
STATE: UNAVAILABLE_BAND (IDLE)
Reason: %s
Target: %s
Distance: %.1f
At retreat distance - idling on ground...
]], 
            S.unavailableReason or "Unknown",
            (target and target.Name or "Unknown"),
            distFromTarget
        )
        updateDebugGui(debugInfo)
        return
    end
    
    -- DIVING STATE - Flying DOWN into river first, then approach underwater
    -- Must be above river bounds to dive down, otherwise fly toward river first
    if S.riverMethodActive and S.waterState == "DRY" and not S.resurfaceMode then
        S.currentState = "DIVING"
        
        -- Keep flight ON during dive
        local isFlying = ensureFlight()
        
        -- Check if we're above the river bounds
        local inRiverBounds = myPos.X >= CONFIG.RIVER_X_MIN and myPos.X <= CONFIG.RIVER_X_MAX
                         and myPos.Z >= CONFIG.RIVER_Z_MIN and myPos.Z <= CONFIG.RIVER_Z_MAX
        
        local diveY = CONFIG.RIVER_SURFACE_Y - 5
        local divePoint
        local mode
        
        if inRiverBounds then
            -- Check if safe to dive here (no land/rocks below)
            if canDiveHere(myPos) then
                -- Above river and safe - dive straight down
                divePoint = Vector3.new(myPos.X, diveY, myPos.Z)
                mode = "DIVING DOWN"
            else
                -- Land below! Fly toward target instead
                if targetPos then
                    divePoint = Vector3.new(targetPos.X, diveY, targetPos.Z)
                else
                    local riverCenterX = (CONFIG.RIVER_X_MIN + CONFIG.RIVER_X_MAX) / 2
                    local riverCenterZ = (CONFIG.RIVER_Z_MIN + CONFIG.RIVER_Z_MAX) / 2
                    divePoint = Vector3.new(riverCenterX, diveY, riverCenterZ)
                end
                mode = "AVOIDING LAND"
            end
        else
            -- Not above river - fly toward target's position (which is in river)
            if targetPos then
                divePoint = Vector3.new(targetPos.X, diveY, targetPos.Z)
            else
                -- Fallback: fly toward river center
                local riverCenterX = (CONFIG.RIVER_X_MIN + CONFIG.RIVER_X_MAX) / 2
                local riverCenterZ = (CONFIG.RIVER_Z_MIN + CONFIG.RIVER_Z_MAX) / 2
                divePoint = Vector3.new(riverCenterX, diveY, riverCenterZ)
            end
            mode = "FLYING TO RIVER"
        end
        
        -- Aim camera toward dive point
        local toDivePoint = safeUnit(divePoint - myPos)
        safeSetCamera(myPos, myPos + toDivePoint * 50)
        
        pulseKey(Enum.KeyCode.W, CONFIG.PULSE_W)
        
        local debugInfo = string.format([[
STATE: DIVING (%s)
Water State: %s
In River Bounds: %s
Can Dive Here: %s
My Y: %.1f | Dive Y: %.1f
Flying: %s
]], 
            mode,
            S.waterState,
            tostring(inRiverBounds),
            tostring(canDiveHere(myPos)),
            myPos.Y,
            diveY,
            tostring(isFlying)
        )
        updateDebugGui(debugInfo)
        return
    end
    
    -- RIVER COMBAT (Change #2: Only run when actually in water)
    -- Dynamic flight: fly when stamina available, walk when not, fly again when recovered
    if S.riverMethodActive and (S.waterState == "SURFACE" or S.waterState == "UNDERWATER") then
        S.currentState = "RIVER_COMBAT"
        
        -- Dynamic flight management - fly when we have stamina
        local stamina = getStamina()
        local canFly = stamina and stamina > getEffectiveStaminaMin()
        local isFlying = false
        
        if canFly and not S.flightDisabledForStamina then
            isFlying = ensureFlight()
        else
            disableFlight()
        end
        
        -- Attempt attack if conditions met
        if targetPos then
            local canAttack, reason = canAttackNow(myPos, targetPos)
            if canAttack then
                executeAttack(myPos, targetPos, distance)
            end
            
            -- Shockwave when target very close
            local canShockwave, shockwaveReason = canShockwaveNow(myPos, targetPos)
            if canShockwave then
                executeShockwave()
            end
        end
        
        -- Dolphin movement toward target (aim at target, can be above water surface)
        if targetPos then
            local toTarget = safeUnit(targetPos - myPos)
            safeSetCamera(myPos, myPos + toTarget * 50)
        end
        
        pulseKey(Enum.KeyCode.W, CONFIG.PULSE_W)
        
        local debugInfo = string.format([[
STATE: RIVER_COMBAT
Air: %.1f / %.1f
Distance: %.1f
Water State: %s
Flying: %s (stamina: %.0f)
]], 
            S.airRemaining, CONFIG.UNDERWATER_MAX_TIME,
            distance,
            S.waterState,
            tostring(isFlying),
            stamina or 0
        )
        updateDebugGui(debugInfo)
        return
    end
-- COMBAT FLOW (main state)
    S.currentState = "COMBAT_FLOW"
    
    -- Handle stuck detection (but NOT if resurfacing - air takes priority)
    if S.resurfaceMode then
        -- Cancel any unsticking when we need to resurface
        if S.isUnsticking then
            resetStuckDetection()
        end
    else
        local stuckTime = updateStuckDetection(myPos, dt)
        if stuckTime > CONFIG.STUCK_TIME_THRESHOLD and not S.isUnsticking then
            startUnsticking(myPos, targetPos)
        end
    end
    
    if S.isUnsticking and not S.resurfaceMode then
        if tick() > S.unstickEndTime then
            resetStuckDetection()
        else
            local dir = S.unstickDirection or Vector3.new(0, 0, 1)
            safeSetCamera(myPos, myPos + dir * 50)
            pulseKey(Enum.KeyCode.W, CONFIG.PULSE_W)
            
            if targetPos and S.targetAvailable then
                local canAttack, reason = canAttackNow(myPos, targetPos)
                if canAttack then
                    executeAttack(myPos, targetPos, distance)
                end
                
                -- Shockwave when target very close
                local canShockwave, shockwaveReason = canShockwaveNow(myPos, targetPos)
                if canShockwave then
                    executeShockwave()
                end
            end
            
            updateDebugGui("STATE: UNSTICKING\nFinding clear path...")
            return
        end
    end
    
    -- Predictive pathing with corridor system (fleeing state already calculated early)
    if targetPos then
        if S.targetIsFleeing and S.targetVelocityAvg.Magnitude > 10 then
            local velocityDir = S.targetVelocityAvg.Unit
            
            -- Check if we need to update direction (corridor break)
            local shouldUpdateDir = false
            
            if not S.targetPredictedDir or not S.targetCorridorAnchor then
                -- No prediction yet, start one
                shouldUpdateDir = true
            else
                -- Check if target left the corridor
                local fromAnchor = targetPos - S.targetCorridorAnchor
                -- Project onto perpendicular of predicted direction to get lateral offset
                local lateral = fromAnchor - S.targetPredictedDir * fromAnchor:Dot(S.targetPredictedDir)
                local lateralDist = lateral.Magnitude
                
                if lateralDist > S.PREDICT_CORRIDOR_WIDTH then
                    -- Target broke out of corridor, update direction
                    shouldUpdateDir = true
                end
            end
            
            if shouldUpdateDir then
                S.targetPredictedDir = velocityDir
                S.targetCorridorAnchor = targetPos
            end
            
            -- Always update predicted POINT (tracks moving target along locked direction)
            -- Clamp to map bounds so we don't aim outside the playable area
            local rawPredicted = targetPos + S.targetPredictedDir * S.PREDICT_LEAD_DISTANCE
            S.targetPredictedPoint = clampToMapBounds(rawPredicted)
        else
            -- Not fleeing or too slow, clear prediction
            S.targetPredictedDir = nil
            S.targetPredictedPoint = nil
            S.targetCorridorAnchor = nil
        end
    else
        -- No target position, clear prediction
        S.targetPredictedDir = nil
        S.targetPredictedPoint = nil
        S.targetCorridorAnchor = nil
    end
    S.targetLastPos = targetPos
    
    -- Update steering mode
    updateSteeringMode(hDist)
    
    -- Ensure flight if needed
    local flying = ensureFlight()
    
    -- Movement and combat based on distance (effectiveCombatZone calculated early)
    local combatMode = "IDLE"
    
    if distance > S.effectiveCombatZone then
        combatMode = "TRAVEL"
    elseif distance > CONFIG.OPTIMAL_MAX then
        combatMode = "APPROACH"
    elseif distance < CONFIG.OPTIMAL_MIN then
        combatMode = "TOO_CLOSE"
    else
        combatMode = "ATTACK"
    end
    
 -- Combat Camera Lock - lerp camera toward target during active combat
    local combatActive = (combatMode == "ATTACK" or combatMode == "TOO_CLOSE")
                     and (S.targetAvailable == true) 
                     and (not S.resurfaceMode) 
                     and (not S.riverMethodActive)
    
    if combatActive then
        -- Distance control only - remote is spoofed so no camera aiming needed
        -- Only snap camera to target when backing up (S needs correct direction)
        if combatMode == "TOO_CLOSE" then
            -- Face target so S moves away
            if targetPos then
                safeSetCamera(myPos, targetPos)
            end
            clearKey(Enum.KeyCode.W)
            clearKey(Enum.KeyCode.A)
            clearKey(Enum.KeyCode.D)
            pulseKey(Enum.KeyCode.S, CONFIG.PULSE_S)
        else
            -- In sweet spot (ATTACK) - strafe side to side
            if targetPos then
                safeSetCamera(myPos, targetPos)
            end
            clearKey(Enum.KeyCode.W)
            clearKey(Enum.KeyCode.S)
            
            -- Alternate A/D every ~1 second
            local strafeDir = math.floor(tick()) % 2
            if strafeDir == 0 then
                clearKey(Enum.KeyCode.D)
                pulseKey(Enum.KeyCode.A, CONFIG.PULSE_A)
            else
                clearKey(Enum.KeyCode.A)
                pulseKey(Enum.KeyCode.D, CONFIG.PULSE_D)
            end
        end
    else
        -- Normal flight/ground steering (not in combat lock)
        if flying then
            if S.steeringMode == "ARC" then
                -- Arc steering: always use diagonal keys for speed boost
                -- Offset camera to compensate so character flies STRAIGHT toward aim point
                
                -- Use predicted intercept point when target is fleeing, otherwise target directly
                -- Sanity check: only use prediction if it's roughly in the same direction as target
                local aimPos = targetPos
                if S.targetIsFleeing and S.targetPredictedPoint and targetPos then
                    local toTarget = (targetPos - myPos).Unit
                    local toPredicted = (S.targetPredictedPoint - myPos).Unit
                    local alignDot = toTarget:Dot(toPredicted)
                    
                    -- Only use prediction if within ~60 degrees of direct path
                    if alignDot > 0.5 then
                        aimPos = S.targetPredictedPoint
                    end
                end
                
                local direction, flightType = getAngledFlightDirection(myPos, aimPos)
                
                -- Always use W+D for speed boost, offset camera LEFT to compensate
                -- (W+D curves right, so camera points left of target = straight flight)
                -- Apply rotation only to horizontal component, preserve Y
                local DIAGONAL_OFFSET_ANGLE = math.rad(40) -- 40 degrees compensates for W+D diagonal
                local horizontalDir = Vector3.new(direction.X, 0, direction.Z)
                local rotatedHorizontal = CFrame.Angles(0, DIAGONAL_OFFSET_ANGLE, 0):VectorToWorldSpace(horizontalDir)
                local offsetDirection = Vector3.new(rotatedHorizontal.X, direction.Y, rotatedHorizontal.Z).Unit
                
                -- Add tiny offset for vertical directions to avoid streaming bug
                local lookAtPos = myPos + offsetDirection * 50
                if math.abs(offsetDirection.X) < 0.01 and math.abs(offsetDirection.Z) < 0.01 then
                    lookAtPos = lookAtPos + Vector3.new(0.001, 0, 0)
                end
                local targetCFrame = CFrame.lookAt(myPos, lookAtPos)
                
                -- Keep CameraSubject set for streaming
                local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
                if hum then Camera.CameraSubject = hum end
                
                -- Dynamic lerp based on how far camera is from target direction
                local currentLook = Camera.CFrame.LookVector
                local targetLook = targetCFrame.LookVector
                local angleDiff = math.acos(math.clamp(currentLook:Dot(targetLook), -1, 1))
                
                -- Scale lerp: small angle diff = gentle, large angle diff = aggressive
                -- Frame-rate independent: scale by dt * 60
                local MIN_ARC_LERP = 0.08
                local MAX_ARC_LERP = 0.35
                local baseLerp = MIN_ARC_LERP + (MAX_ARC_LERP - MIN_ARC_LERP) * math.clamp(angleDiff / math.rad(90), 0, 1)
                local arcLerp = math.min(1, baseLerp * dt * 60)
                
                Camera.CFrame = Camera.CFrame:Lerp(targetCFrame, arcLerp)
                
                -- Always W+D for diagonal speed
                pulseKey(Enum.KeyCode.W, CONFIG.PULSE_W)
                pulseKey(Enum.KeyCode.D, CONFIG.PULSE_D)
                clearKey(Enum.KeyCode.A)
            else
                -- Slope steering (precision)
                local direction, flightType = getAngledFlightDirection(myPos, targetPos)
                safeSetCamera(myPos, myPos + direction * 50)
                pulseKey(Enum.KeyCode.W, CONFIG.PULSE_W)
                clearKey(Enum.KeyCode.A)
                clearKey(Enum.KeyCode.D)
            end
        else
            -- Ground movement
            if targetPos then
                local toTarget = safeUnit(Vector3.new(targetPos.X - myPos.X, 0, targetPos.Z - myPos.Z))
                safeSetCamera(myPos, myPos + toTarget * 50)
                pulseKey(Enum.KeyCode.W, CONFIG.PULSE_W)
            end
        end
    end
    
    -- Combat execution
    if combatMode == "ATTACK" or combatMode == "TOO_CLOSE" then
        local canAttack, reason = canAttackNow(myPos, targetPos)
        if canAttack then
            executeAttack(myPos, targetPos, distance)
        end
        
        -- Shockwave when target very close (works both on ground and in flight)
        local canShockwave, shockwaveReason = canShockwaveNow(myPos, targetPos)
        if canShockwave then
            executeShockwave()
        end
    end
    
    -- Debug info
    local fleeStatus = ""
    if S.targetIsFleeing then
        if S.targetPredictedPoint then
            fleeStatus = "(FLEEING+PREDICT)"
        else
            fleeStatus = "(FLEEING)"
        end
    end
    
    local debugInfo = string.format([[
STATE: %s
Target: %s %s
Distance: %.1f (optimal: %d-%d)
Combat: %s (entry: %.0f)
Steering: %s %s
Target speed: %.1f studs/s
Flying: %s (stamina disabled: %s)
Water: %s | Air: %.1f
River method: %s
Available: %s
]], 
        S.currentState,
        (target and target.Name or "Unknown"),
        S.onSecondaryTarget and "(SECONDARY)" or "",
        distance, CONFIG.OPTIMAL_MIN, CONFIG.OPTIMAL_MAX,
        combatMode, S.effectiveCombatZone,
        S.steeringMode,
        fleeStatus,
        S.targetVelocityAvg.Magnitude,
        tostring(flying), tostring(S.flightDisabledForStamina),
        S.waterState, S.airRemaining,
        tostring(S.riverMethodActive),
        tostring(S.targetAvailable)
    )
    updateDebugGui(debugInfo)
end

