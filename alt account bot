local function canShockwaveNow(myPos, targetPos)
    if not myPos or not targetPos then return false, "NO_POSITION" end
    
    -- Stamina check for shockwave
    local stamina = getStamina()
    if stamina and stamina < CONFIG.SHOCKWAVE_STAMINA_COST then
        return false, "LOW_STAMINA"
    end
    
    -- Check cooldown
    local now = tick()
    if now - S.lastShockwaveTime < CONFIG.SHOCKWAVE_COOLDOWN then
        return false, "COOLDOWN"
    end
    
    -- Check horizontal distance (XZ plane only)
    local horizontalDist = math.sqrt((targetPos.X - myPos.X)^2 + (targetPos.Z - myPos.Z)^2)
    if horizontalDist > CONFIG.SHOCKWAVE_HORIZONTAL_RANGE then
        return false, "TOO_FAR_HORIZONTAL"
    end
    
    -- Check vertical distance
    local verticalDist = math.abs(targetPos.Y - myPos.Y)
    if verticalDist > CONFIG.SHOCKWAVE_VERTICAL_RANGE then
        return false, "TOO_FAR_VERTICAL"
    end
    
    -- Target checks
    local target = getCurrentTarget()
    if not target then return false, "NO_TARGET" end
    if not isPlayerAlive(target) then return false, "TARGET_DEAD" end
    
    return true, "CLEAR"
end

local function executeShockwave()
    local now = tick()
    
    -- Press Z for shockwave
    pcall(function()
        VirtualInputManager:SendKeyEvent(true, Enum.KeyCode.Z, false, game)
    end)
    task.wait(0.05)
    pcall(function()
        VirtualInputManager:SendKeyEvent(false, Enum.KeyCode.Z, false, game)
    end)
    
    S.lastShockwaveTime = now
    return true
end

