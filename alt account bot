local function safeUnit(v, fallback)
    if not v then return fallback or Vector3.new(0, 0, -1) end
    local mag = v.Magnitude
    if mag > 1e-6 then return v / mag end
    return fallback or Vector3.new(0, 0, -1)
end

local function isValidVector(v)
    if not v then return false end
    return v.X == v.X and v.Y == v.Y and v.Z == v.Z -- NaN check
end

local function isValidNumber(n)
    return n and n == n and math.abs(n) < 1e10
end

-- Safe camera setting: prevents streaming bug by keeping CameraSubject set
-- and adding tiny offset to avoid perfect vertical look directions
local function safeSetCamera(myPos, lookAtPos)
    -- Keep CameraSubject set to prevent streaming unload
    local hum = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
    if hum then
        Camera.CameraSubject = hum
    end
    
    -- Add tiny offset to lookAt to avoid perfect vertical (causes streaming bug)
    local dir = lookAtPos - myPos
    if math.abs(dir.X) < 0.01 and math.abs(dir.Z) < 0.01 then
        -- Looking nearly straight up or down, add tiny X offset
        lookAtPos = lookAtPos + Vector3.new(0.001, 0, 0)
    end
    
    Camera.CFrame = CFrame.lookAt(myPos, lookAtPos)
end

local function clampPosition(pos)
    if not isValidVector(pos) then return Vector3.new(0, 50, 0) end
    local x = math.clamp(pos.X, -10000, 10000)
    local y = math.clamp(pos.Y, -10000, 10000)
    local z = math.clamp(pos.Z, -10000, 10000)
    return Vector3.new(x, y, z)
end

