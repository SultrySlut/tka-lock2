local function getCurrentTarget()
    -- Priority: secondary -> temp (self-defense/help-alt) -> primary
    
    -- 1. Secondary target (if active)
    if S.onSecondaryTarget and S.activeSecondaryUserId then
        return getPlayerByUserId(S.activeSecondaryUserId)
    end
    
    -- 2. Temp target (self-defense or help-alt)
    local tempTarget = getTempTarget()
    if tempTarget then
        return tempTarget
    end
    
    -- 3. Primary target
    return S.targetPlayer
end

